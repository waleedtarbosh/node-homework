{
  "info": {
    "name": "Assignment 8 - CTD",
    "description": "Collection for testing Authentication, JWT, and CSRF tokens for Assignment 8.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Register",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const jsonData = pm.response.json();",
              "if (jsonData.csrfToken) {",
              "    pm.environment.set(\"csrfToken\", jsonData.csrfToken);",
              "    console.log(\"CSRF Token captured from Register: \", jsonData.csrfToken);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Waleed Tarbosh\",\n  \"email\": \"waleed.space@example.com\",\n  \"password\": \"Password123!\"\n}"
        },
        "url": {
          "raw": "http://localhost:3000/api/users/register",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "3000",
          "path": [
            "api",
            "users",
            "register"
          ]
        }
      }
    },
    {
      "name": "2. Logon",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const jsonData = pm.response.json();",
              "if (jsonData.csrfToken) {",
              "    pm.environment.set(\"csrfToken\", jsonData.csrfToken);",
              "    console.log(\"CSRF Token captured from Logon: \", jsonData.csrfToken);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"waleed.space@example.com\",\n  \"password\": \"Password123!\"\n}"
        },
        "url": {
          "raw": "http://localhost:3000/api/users/logon",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "3000",
          "path": [
            "api",
            "users",
            "logon"
          ]
        }
      }
    },
    {
      "name": "3. Create Task (Protected)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-TOKEN",
            "value": "{{csrfToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Test CSRF Token with JWT\",\n  \"priority\": \"high\"\n}"
        },
        "url": {
          "raw": "http://localhost:3000/api/tasks",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "3000",
          "path": [
            "api",
            "tasks"
          ]
        }
      }
    },
    {
      "name": "4. Get All Tasks (Protected)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/api/tasks",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "3000",
          "path": [
            "api",
            "tasks"
          ]
        }
      }
    },
    {
      "name": "5. Logoff (Protected)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-CSRF-TOKEN",
            "value": "{{csrfToken}}"
          }
        ],
        "url": {
          "raw": "http://localhost:3000/api/users/logoff",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "3000",
          "path": [
            "api",
            "users",
            "logoff"
          ]
        }
      }
    }
  ]
}