# ==============================================================================
# DATABASE CONFIGURATION
# You only need to use ONE of the options below (Option 1 OR Option 2).
# Uncomment the one you want to use and fill in your credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# Option 1: Cloud Database (e.g., Neon.tech, Supabase, AWS)
# Use this if your database is hosted online.
# ------------------------------------------------------------------------------
DB_URL=postgresql://[user]:[password]@[host].neon.tech/nodehomework?sslmode=require
DATABASE_URL=postgresql://[user]:[password]@[host].neon.tech/tasklist?sslmode=require
TEST_DATABASE_URL=postgresql://[user]:[password]@[host].neon.tech/testtasklist?sslmode=require
JWT_SECRET=your_jwt_secret_here
# ------------------------------------------------------------------------------
# Option 2: Local Database (for offline development)
# Use this if you are running PostgreSQL locally on your own machine.
# ------------------------------------------------------------------------------
# DB_URL=postgresql://[username]:[password]@localhost/nodehomework
# DATABASE_URL=postgresql://[username]:[password]@localhost/tasklist
# TEST_DATABASE_URL=postgresql://[username]:[password]@localhost/testtasklist
